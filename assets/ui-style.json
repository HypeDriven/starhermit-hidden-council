        "width": 1,
        "color": "#3a4060",
        "style": "solid"
      },
      "radius": 10,
      "padding": {
        "top": 10,
        "end": 18,
        "bottom": 10,
        "start": 18
      },
      "minWidth": 44,
      "minHeight": 44,
      "transition": {
        "properties": "transform",
        "duration": 0.08,
