  "animations": {},
  "tokens": {
    "accent": "#ffb54d",
    "bg": "#0d0f16",
    "danger": "#ff6b6b",
    "focus": "#6bd5ff",
    "line": "#2c3048",
    "line-2": "#3a4060",
